{
  "manifest_version": 3,
  "minimum_chrome_version": "96",
  "name": "Cookie Janitor",
  "version": "0.6.0",
  "description": "Painel de faxina de cookies: cruza cookies com seu histórico, mostra o que você não usa e deleta com backup.",
  "permissions": ["cookies", "history", "storage", "browsingData"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icones/icone-16.png",
    "32": "icones/icone-32.png",
    "48": "icones/icone-48.png",
    "128": "icones/icone-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cookie Janitor",
    "default_icon": {
      "16": "icones/icone-16.png",
      "32": "icones/icone-32.png",
      "48": "icones/icone-48.png",
      "128": "icones/icone-128.png"
    }
  }
}
